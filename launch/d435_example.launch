<?xml version="1.0" ?>
<launch>
  <node pkg="sensor_filters" exec="pointcloud2_filter_chain" name="pointcloud2_filters" output="screen">
    <remap from="input" to="/D435_camera/depth/color/points" />
    <remap from="output" to="/D435_camera/depth/color/points/filtered" />
    
    <param from="$(find-pkg-share point_cloud2_filters)/config/d435_example.yaml" />
  </node>
</launch>
